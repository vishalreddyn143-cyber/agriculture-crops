# ==================================================
# VISTA AGRI AI - BACKEND ENVIRONMENT CONFIG TEMPLATE
# ==================================================

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Optional: in-memory store is used if omitted)
MONGODB_URI=mongodb://127.0.0.1:27017/vista-agri-ai

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Groq API key for the Ask VISTA AI chatbot (https://console.groq.com/keys)
# Without it the chatbot falls back to built-in rule-based answers.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase: farmer login accounts are stored in the `farmers` table.
# Use the project's secret (service role) key; it must never be exposed to the browser.
# Without these, accounts are kept in memory and lost on restart.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
