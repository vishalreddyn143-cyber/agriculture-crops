# ==================================================
# VISTA AGRI AI - BACKEND ENVIRONMENT CONFIG TEMPLATE
# ==================================================

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Optional: in-memory store is used if omitted)
MONGODB_URI=mongodb://127.0.0.1:27017/vista-agri-ai

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Optional: Cloud LLM API Key (if extending AI engine)
# GEMINI_API_KEY=your_gemini_api_key_here
